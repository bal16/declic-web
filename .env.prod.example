# Production-like env for `docker compose -f docker-compose.yml
# -f docker-compose.prod.yml --env-file .env.prod up`.
# Copy to .env.prod and fill in. NEVER commit .env.prod (gitignored).
# Unlike dev, secrets have NO defaults here — compose fails fast if empty.

# Images (defaults pull GHCR :latest; point at :local tags after `up --build`)
# API_IMAGE=ghcr.io/bal16/declic-api:latest
# WORKER_IMAGE=ghcr.io/bal16/declic-worker:latest
# WEB_IMAGE=ghcr.io/bal16/declic-web:latest

# Database / queue / storage (same hostnames inside the compose network)
DATABASE_URL=
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=declic
S3_FORCE_PATH_STYLE=true

# Better Auth (NO dev default on purpose)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Baked into the web image at BUILD time (see apps/web/Dockerfile ARG)
VITE_API_URL=http://localhost:3001
VITE_BETTER_AUTH_URL=http://localhost:3001

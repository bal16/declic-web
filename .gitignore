# Dependencies
node_modules/

# Local env (never commit real secrets)
.env
.env.prod
.env*.local

# Build outputs
dist/
build/
.next/
out/
.output/
coverage/
# Coverage reports (regenerated by bun run coverage)
lcov.info

# Logs
*.log

# OS / editor
.DS_Store

# Obsidian vault config (local-only: workspace layout, appearance, plugins)
/.obsidian/
docs/.obsidian/*
# Shared vault essentials (status board needs the plugin list to render)
!docs/.obsidian/community-plugins.json

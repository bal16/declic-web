{
  "name": "@declic/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun --watch --env-file ../../.env src/main.ts",
    "start": "NODE_ENV=production bun src/main.ts",
    "test": "bun test src/",
    "test:watch": "bun test --watch src/",
    "test:coverage": "bun test --coverage src/",
    "test:e2e": "bun test test/e2e/",
    "test:integration": "bun --env-file=../../.env test --timeout 60000 test/integration/",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@declic/contracts": "workspace:*",
    "@declic/db": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "blurhash": "^2.0.5",
    "bullmq": "^6.3.4",
    "drizzle-orm": "1.0.0-rc.4",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.4.1",
    "@types/pngjs": "^6.0.5",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}

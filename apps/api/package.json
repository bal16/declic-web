{
  "name": "@declic/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun --watch --env-file ../../.env src/main.ts",
    "start": "NODE_ENV=production bun src/main.ts",
    "test": "bun test src/",
    "test:watch": "bun test --watch src/",
    "test:coverage": "bun test --coverage src/",
    "test:e2e": "bun test test/",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@declic/contracts": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@scalar/nestjs-api-reference": "1.2.17",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.2",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "minio": "^8.0.7",
    "nestjs-zod": "^5.5.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/minio": "^7.1.1",
    "@types/node": "^26.4.1",
    "bun-types": "^1.4.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}

{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Explicit: oxfmt defaults to 100, Prettier (and this repo) to 80.
  "printWidth": 80,
  // Match the repo's existing single-quote style (NestJS convention).
  "singleQuote": true,
  "sortImports": {},
  "sortTailwindcss": {
    "stylesheet": "./apps/web/src/styles.css",
  },
  "ignorePatterns": [
    "apps/web/.output/**",
    "**/dist/**",
    "apps/web/src/routeTree.gen.ts",
    "docs/**",
  ],
}

views:
  - type: kanban-view
    name: All
    filters:
      and:
        - file.ext == "md"
        - not:
            - file.name == "README"
    columnOrders:
      file.file:
        - README.md
        - adr/ADR-001-monorepo-mirror.md
        - adr/ADR-002-release-tagging.md
        - adr/ADR-003-zod-dto-strategy.md
        - adr/ADR-004-direct-pino-logging.md
        - adr/ADR-005-modular-monolith.md
        - adr/ADR-006-branch-protection.md
        - adr/ADR-007-path-aliases.md
        - adr/ADR-008-docs-reorg.md
        - data/db-schema.md
        - data/seed.ts
        - data/seeds.md
        - features/README.md
        - features/auth-rbac.md
        - features/curation-moderation.md
        - features/engagement.md
        - features/exhibition-lifecycle.md
        - features/feature-flags-site-settings.md
        - features/gallery-discovery.md
        - features/series-upload.md
        - features/withdraw-work.md
        - guides/DESIGN.md
        - guides/DEVELOPMENT.md
        - guides/backend.md
        - guides/frontend.md
        - ops/docker-compose.md
        - ops/docker-compose.yml
        - ops/env.md
        - specs/PRD-API.md
        - specs/PRD-FE.md
        - specs/PRD-UI.md
        - specs/PRD-Worker.md
        - specs/PRD.md
        - specs/contracts.md
        - status-board.base
      note.status:
        - draft
        - living
        - accepted
    cardOrders:
      file.file: {}
      note.status: {}
    columnColors:
      file.file: {}
      note.status: {}
    cardTitleProperty: note.aliases
    groupByProperty: note.status

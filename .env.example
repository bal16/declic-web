# Copy this file to .env before running `bun install` / `docker compose up`.
# See docs/DEVELOPMENT.md §4. Never commit .env with real secrets.

# Postgres
POSTGRES_USER=pameranfoto
POSTGRES_PASSWORD=pameranfoto
POSTGRES_DB=pameranfoto_dev
DATABASE_URL=postgres://pameranfoto:pameranfoto@postgres:5432/pameranfoto_dev

# Queue
REDIS_URL=redis://redis:6379

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=pameran-foto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Logging (api + worker, nestjs-pino; debug/dev default, info/prod default)
# LOG_LEVEL=debug
# Better Auth (mounted on the NestJS API — OAuth-only: Google + GitHub)
BETTER_AUTH_SECRET=12430e12-d3a9-40d4-bdfa-58a9d1b4e76f
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend (TanStack Start — client vars use the VITE_ prefix)
VITE_API_URL=http://localhost:3001
VITE_BETTER_AUTH_URL=http://localhost:3001

{
  // Schema untuk autocomplete di Neovim (marksman + jsonls)
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",

  // Config ini 1:1 dengan yang dipakai Neovim kamu:
  // LazyVim extras/lang/markdown -> nvim-lint (markdownlint-cli2) + conform (prettier + markdownlint-cli2) + marksman
  // Linter di-load via mason: markdownlint-cli2, markdown-toc
  // File ini otomatis kepakai oleh `nvim-lint` dan `markdownlint-cli2` CLI

  "config": {
    "default": true,

    // MD013 - line length dimatikan total (no rule)
    "MD013": false,

    // MD033 - allow inline HTML (komentar <!-- toc --> dipakai markdown-toc)
    "MD033": false,

    // MD041 - first line tidak harus h1 (PRD kamu mulai dengan metadata)
    "MD041": false,

    // MD060 - table column style dimatikan, biar prettier yang atur spacing `| --- |`
    // Ini yang bikin error di PRD.md:83 `|---|---|---|`
    "MD060": false
  },

  // markdownlint-cli2 specific (bukan markdownlint biasa)
  "globs": ["**/*.md", "**/*.markdown"],
  "ignores": ["node_modules/**", ".git/**", ".next/**", "dist/**", "build/**", "coverage/**"],

  // Auto-fix untuk rule yang fixable saat :Conform atau markdownlint-cli2 --fix
  "fix": {
    "MD013": false
  }
}

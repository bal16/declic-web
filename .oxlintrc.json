{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "import", "typescript", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "react/hooks": "error",
    "import/no-cycle": ["error", { "maxDepth": 3 }],
    "import/no-self-import": "error",
    "typescript/no-non-null-assertion": "error",
    "eqeqeq": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/src/routeTree.gen.ts"],
      "rules": {
        "eqeqeq": "off",
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      // bun's `expect().rejects` chain is runtime-thenable but typed as
      // plain Matchers; awaiting it is required or the assertion never
      // evaluates. Narrow exemption: these files have no other
      // await-thenable findings.
      "files": [
        "apps/worker/src/worker.module.test.ts",
        "apps/worker/src/image-processing/image.processor.test.ts",
        "apps/worker/src/image-processing/object-storage.service.test.ts"
      ],
      "rules": {
        "typescript/await-thenable": "off"
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error"
      }
    },
    {
      "files": ["**/*.test.ts", "**/test/**"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}

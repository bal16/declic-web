{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "import", "typescript", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/hooks": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/**"],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error"
      }
    },
    {
      "files": ["**/*.test.ts", "**/test/**"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    }
  ]
}

{
  "name": "declic",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env run --filter \"@declic/*\" dev",
    "build": "bun --env-file=.env run --filter \"@declic/*\" build",
    "test": "bun run --filter \"@declic/*\" test",
    "test:watch": "bun run --filter \"@declic/*\" test:watch",
    "test:coverage": "bun run --filter \"@declic/*\" test:coverage",
    "test:e2e": "bun --env-file=.env run --filter \"@declic/*\" test:e2e",
    "typecheck": "bun run --filter \"@declic/*\" typecheck",
    "worker:dev": "bun --env-file=.env run --filter @declic/worker dev",
    "worker:test": "bun run --filter @declic/worker test",
    "worker:test:watch": "bun run --filter @declic/worker test:watch",
    "worker:test:coverage": "bun run --filter @declic/worker test:coverage",
    "worker:test:e2e": "bun --env-file=.env run --filter @declic/worker test:e2e",
    "worker:typecheck": "bun run --filter @declic/worker typecheck",
    "api:dev": "bun --env-file=.env run --filter @declic/api dev",
    "api:test": "bun run --filter @declic/api test",
    "api:test:watch": "bun run --filter @declic/api test:watch",
    "api:test:coverage": "bun run --filter @declic/api test:coverage",
    "api:test:e2e": "bun --env-file=.env run --filter @declic/api test:e2e",
    "api:typecheck": "bun run --filter @declic/api typecheck",
    "web:dev": "bun --env-file=.env run --filter @declic/web dev",
    "web:build": "bun --env-file=.env run --filter @declic/web build",
    "web:test": "bun run --filter @declic/web test",
    "web:test:watch": "bun run --filter @declic/web test:watch",
    "web:test:coverage": "bun run --filter @declic/web test:coverage",
    "web:test:e2e": "bun --env-file=.env run --filter @declic/web test:e2e",
    "web:typecheck": "bun run --filter @declic/web typecheck",
    "coverage": "bun scripts/check-coverage.ts",
    "boundaries": "bun scripts/check-boundaries.ts",
    "sync:compose": "bun scripts/sync-compose.ts",
    "sync:docs": "bun scripts/sync-docs-mirrors.ts",
    "db:generate": "bun run --filter @declic/db generate",
    "db:migrate": "bun --env-file=.env run --filter @declic/db migrate",
    "db:studio": "bun --env-file=.env run --filter @declic/db studio",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.4.1",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2003"
  },
  "packageManager": "bun@1.4.2"
}

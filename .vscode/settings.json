{
  "workbench.colorCustomizations": {
    "minimap.background": "#00000000",
    "scrollbar.shadow": "#00000000"
  },
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  // oxc owns lint + format in this repo — keep ESLint/Prettier extensions
  // from fighting it (double-formatters, conflicting fix-on-save).
  "eslint.enable": false,
  "prettier.enable": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.format.oxc": "explicit"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  // Markdown is intentionally formatter-less in this repo: oxfmt ignores
  // docs/** and no markdown formatter runs in CI. Keep it that way locally
  // too — otherwise yzhang.markdown-all-in-one reformats tables on save
  // and produces phantom diffs (e.g. docs/docker-compose.md realignment).
  // The extension stays useful for TOC/shortcuts; only its formatter is off.
  // Lint still comes from davidanson.vscode-markdownlint (.markdownlint.jsonc).
  "[markdown]": {
    "editor.formatOnSave": false
  }
}
